{
  "name": "t3-private-browser",
  "version": "1.0.0",
  "description": "T3 Private Browser by Tinotenda Enock Mapfumo (Dr TEMMC)",
  "main": "main.js",
  "author": "Tinotenda Enock Mapfumo (Dr TEMMC)",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.temmc.t3browser",
    "productName": "T3 Private Browser",
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "linux": { "target": "AppImage" }
  }
}
