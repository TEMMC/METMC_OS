<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.METMC OS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#FF1A1A2E</item>
        <item name="colorPrimaryDark">#FF0F0F1A</item>
        <item name="colorAccent">#FF6C63FF</item>
    </style>

    <style name="Theme.METMC OS.Fullscreen" parent="Theme.METMC OS">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#FFFF0000</item>
    </style>

    <style name="Theme.METMC OS.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/metmc_primary</item>
        <item name="colorSecondary">@color/metmc_success</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/metmc_background</item>
        <item name="android:navigationBarColor">@color/metmc_background</item>
        <item name="android:windowBackground">@color/metmc_background</item>
    </style>
</resources>
